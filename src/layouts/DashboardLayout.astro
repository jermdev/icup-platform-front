---
import type { User } from "../types";
import {
  Home,
  Calendar,
  User as UserIcon,
  LogOut,
  Menu,
  X,
} from "lucide-react";

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user as User | undefined;

if (!user) {
  return Astro.redirect("/login");
}

const navItems = [
  { name: "Dashboard", href: "/dashboard", icon: Home },
  { name: "My Events", href: "/my-events", icon: Calendar },
  { name: "Profile", href: "/profile", icon: UserIcon },
];

const currentPath = Astro.url.pathname;
console.log(currentPath);

console.log(Astro.locals.user);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Unidos en Su Presencia</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="bg-gray-50 ">
    <div class="min-h-screen flex">
      <!-- Sidebar Desktop -->
      <aside
        id="sidebar"
        class="hidden lg:flex lg:flex-col w-64 bg-white border-r border-gray-200 fixed h-full sm: background-white"
      >
        <!-- Logo -->
        <div class="p-6 border-b border-gray-200">
          <a href="/" class="flex items-center space-x-3 group">
            <div
              class="w-10 h-10 bg-gradient-to-br from-church-deep-blue to-church-blue rounded-full flex items-center justify-center"
            >
              <span class="text-white font-bold">UP</span>
            </div>
            <div>
              <h1 class="text-lg font-bold text-church-deep-blue">
                Unidos en Su Presencia
              </h1>
            </div>
          </a>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 px-4 py-6">
          <ul class="space-y-2">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class={`flex items-center space-x-3 px-4 py-3 rounded-lg font-medium transition-all ${
                      currentPath === item.href ||
                      currentPath.startsWith(item.href + "/")
                        ? "bg-church-blue text-white"
                        : "text-gray-700 hover:bg-gray-100"
                    }`}
                  >
                    <item.icon className="w-5 h-5" />
                    <span>{item.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <!-- User Section -->
        <div class="p-4 border-t border-gray-200">
          <div class="flex items-center space-x-3 px-4 py-3">
            <img
              src={user.profileImage ||
                `https://ui-avatars.com/api/?name=${user.firstName}+${user.lastName}&background=2563eb&color=fff`}
              alt={user.firstName}
              class="w-10 h-10 rounded-full"
            />
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900 truncate">
                {user.firstName}
                {user.lastName}
              </p>
              <p class="text-xs text-gray-500 truncate">{user.email}</p>
            </div>
          </div>
          <button
            id="logout-btn"
            class="w-full mt-2 flex items-center justify-center space-x-2 px-4 py-2 bg-red-50 text-red-700 rounded-lg font-medium hover:bg-red-100 transition-colors"
          >
            <LogOut className="w-4 h-4" />
            <span>Cerrar Sesión1</span>
          </button>
        </div>
      </aside>

      <!-- Main Content -->
      <div class="flex-1 lg:ml-64">
        <!-- Mobile Header -->
        <header
          class="lg:hidden bg-white border-b border-gray-200 sticky top-0 z-40"
        >
          <div class="flex items-center justify-between p-4">
            <button
              id="mobile-menu-btn"
              class="p-2 rounded-lg hover:bg-gray-100"
            >
              <Menu className="w-6 h-6" />
            </button>
            <h1 class="text-lg font-bold text-church-deep-blue">{title}</h1>
            <div class="w-10"></div>
          </div>
        </header>

        <!-- Mobile Sidebar -->
        <div
          id="mobile-sidebar"
          class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden lg:hidden"
        >
          <aside class="w-64 bg-white h-full">
            <div
              class="p-4 border-b border-gray-200 flex items-center justify-between"
            >
              <h2 class="text-lg font-bold text-church-deep-blue">Menú</h2>
              <button
                id="close-mobile-menu"
                class="p-2 rounded-lg hover:bg-gray-100"
              >
                <X className="w-6 h-6" />
              </button>
            </div>

            <nav class="px-4 py-6">
              <ul class="space-y-2">
                {
                  navItems.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class={`flex items-center space-x-3 px-4 py-3 rounded-lg font-medium transition-all ${
                          currentPath === item.href
                            ? "bg-church-blue text-white"
                            : "text-gray-700 hover:bg-gray-100"
                        }`}
                      >
                        <item.icon className="w-5 h-5" />
                        <span>{item.name}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>

            <div
              class="absolute bottom-0 left-0 right-0 p-4 border-t border-gray-200"
            >
              <div class="flex items-center space-x-3 px-4 py-3">
                <img
                  src={user.profileImage ||
                    `https://ui-avatars.com/api/?name=${user.firstName}+${user.lastName}&background=2563eb&color=fff`}
                  alt={user.firstName}
                  class="w-10 h-10 rounded-full"
                />
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-gray-900 truncate">
                    {user.firstName}
                    {user.lastName}
                  </p>
                  <p class="text-xs text-gray-500 truncate">{user.email}</p>
                </div>
              </div>
              <button
                class="w-full mt-2 flex items-center justify-center space-x-2 px-4 py-2 bg-red-50 text-red-700 rounded-lg font-medium hover:bg-red-100 transition-colors mobile-logout-btn"
              >
                <LogOut className="w-4 h-4" />
                <span>Cerrar Sesión1</span>
              </button>
            </div>
          </aside>
        </div>

        <!-- Page Content -->
        <main class="p-6">
          <slot />
        </main>
      </div>
    </div>

    <script>
      import { api } from "../lib/api";

      // Mobile menu toggle
      const mobileMenuBtn = document.getElementById("mobile-menu-btn");
      const mobileSidebar = document.getElementById("mobile-sidebar");
      const closeMobileMenu = document.getElementById("close-mobile-menu");

      mobileMenuBtn?.addEventListener("click", () => {
        mobileSidebar?.classList.remove("hidden");
      });

      closeMobileMenu?.addEventListener("click", () => {
        mobileSidebar?.classList.add("hidden");
      });

      mobileSidebar?.addEventListener("click", (e) => {
        if (e.target === mobileSidebar) {
          mobileSidebar.classList.add("hidden");
        }
      });

      // Logout functionality
      async function handleLogout() {
        try {
          await api.logout();
          window.location.href = "/login";
        } catch (error) {
          console.error("Logout error:", error);
          // Force redirect even if API call fails
          window.location.href = "/login";
        }
      }

      document
        .getElementById("logout-btn")
        ?.addEventListener("click", handleLogout);
      document.querySelectorAll(".mobile-logout-btn").forEach((btn) => {
        btn.addEventListener("click", handleLogout);
      });
    </script>
  </body>
</html>
