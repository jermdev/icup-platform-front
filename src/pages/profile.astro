---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import EventCard from "../components/EventCard.astro";
import type { User, Event } from "../types";
import { Mail, Shield, Calendar, Settings } from "lucide-react";
import { getRoleBadgeColor, getRoleDisplayName } from "../lib/utils/roles";

const user = Astro.locals.user as User;

if (!user) {
  return Astro.redirect("/login");
}

// Fetch user's attending events
let attendingEvents: Event[] = [];

try {
  const eventsResponse = await fetch(
    `${import.meta.env.PUBLIC_API_URL || "http://localhost:3000/api"}/events`
  );
  if (eventsResponse.ok) {
    const allEvents: Event[] = await eventsResponse.json();
    attendingEvents = allEvents.filter((event) =>
      event.attendingUsers.includes(user._id)
    );
  }
} catch (error) {
  console.error("Error fetching events:", error);
}

const preferences = [
  { label: "Notificaciones por email", enabled: true },
  { label: "Recordatorios de eventos", enabled: true },
  { label: "Newsletter mensual", enabled: false },
  { label: "Actualizaciones de la iglesia", enabled: true },
];
---

<DashboardLayout title="Mi Perfil">
  <div class="max-w-4xl mx-auto">
    <!-- Profile Header -->
    <div class="card mb-6">
      <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
        <img
          src={user.profileImage ||
            `https://ui-avatars.com/api/?name=${user.firstName}+${user.lastName}&size=200&background=2563eb&color=fff`}
          alt={`${user.firstName} ${user.lastName}`}
          class="w-32 h-32 rounded-full border-4 border-church-blue/20"
        />

        <div class="flex-1 text-center md:text-left">
          <h1 class="text-3xl font-bold text-church-deep-blue mb-2">
            {user.firstName}
            {user.lastName}
          </h1>

          <div
            class="flex flex-wrap items-center justify-center md:justify-start gap-3 mb-4"
          >
            <div class="flex items-center text-gray-600">
              <Mail className="w-4 h-4 mr-2" />
              <span>{user.email}</span>
            </div>

            <span
              class={`px-3 py-1 rounded-full text-sm font-semibold border ${getRoleBadgeColor(user.role)}`}
            >
              <Shield className="w-4 h-4 inline mr-1" />
              {getRoleDisplayName(user.role)}
            </span>
          </div>

          <button class="btn-outline">
            <Settings className="w-4 h-4 inline mr-2" />
            Editar Perfil
          </button>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <div class="card text-center">
        <div class="text-3xl font-bold text-church-blue mb-1">
          {attendingEvents.length}
        </div>
        <div class="text-sm text-gray-600">Eventos Inscritos</div>
      </div>

      <div class="card text-center">
        <div class="text-3xl font-bold text-green-600 mb-1">
          {attendingEvents.filter((e) => new Date(e.date) < new Date()).length}
        </div>
        <div class="text-sm text-gray-600">Eventos Asistidos</div>
      </div>

      <div class="card text-center">
        <div class="text-3xl font-bold text-purple-600 mb-1">
          {attendingEvents.filter((e) => new Date(e.date) > new Date()).length}
        </div>
        <div class="text-sm text-gray-600">Próximos Eventos</div>
      </div>
    </div>

    <!-- My Events -->
    {
      attendingEvents.length > 0 && (
        <div class="card mb-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-church-deep-blue">
              <Calendar className="w-6 h-6 inline mr-2" />
              Mis Eventos
            </h2>
            <a
              href="/eventos"
              class="text-church-blue hover:text-church-deep-blue font-medium text-sm"
            >
              Ver Todos →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {attendingEvents.slice(0, 4).map((event) => (
              <EventCard event={event} showActions={false} isAttending={true} />
            ))}
          </div>
        </div>
      )
    }

    <!-- Preferences -->
    <div class="card">
      <h2 class="text-xl font-bold text-church-deep-blue mb-4">
        <Settings className="w-6 h-6 inline mr-2" />
        Preferencias
      </h2>

      <div class="space-y-4">
        {
          preferences.map((pref) => (
            <div class="flex items-center justify-between py-3 border-b border-gray-100 last:border-0">
              <span class="text-gray-700">{pref.label}</span>
              <button
                class={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${
                  pref.enabled ? "bg-church-blue" : "bg-gray-300"
                }`}
                data-preference={pref.label}
                data-enabled={pref.enabled}
              >
                <span
                  class={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${
                    pref.enabled ? "translate-x-6" : "translate-x-1"
                  }`}
                />
              </button>
            </div>
          ))
        }
      </div>

      <div class="mt-6 p-4 bg-blue-50 rounded-lg">
        <p class="text-sm text-gray-600">
          💡 <strong>Nota:</strong> Estas preferencias son de demostración. Pronto
          podrás personalizar completamente tu experiencia.
        </p>
      </div>
    </div>
  </div>
</DashboardLayout>

<script is:raw>
  // Toggle preferences (UI only for now)
  document.querySelectorAll("[data-preference]").forEach((button) => {
    button.addEventListener("click", (e) => {
      const btn = e.currentTarget as HTMLElement;
      const enabled = btn.dataset.enabled === "true";

      // Toggle UI
      if (enabled) {
        btn.classList.remove("bg-church-blue");
        btn.classList.add("bg-gray-300");
        btn.dataset.enabled = "false";
        const span = btn.querySelector("span");
        span?.classList.remove("translate-x-6");
        span?.classList.add("translate-x-1");
      } else {
        btn.classList.remove("bg-gray-300");
        btn.classList.add("bg-church-blue");
        btn.dataset.enabled = "true";
        const span = btn.querySelector("span");
        span?.classList.remove("translate-x-1");
        span?.classList.add("translate-x-6");
      }

      console.log("Preference toggled:", btn.dataset.preference, !enabled);
    });
  });
</script>
