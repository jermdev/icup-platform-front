---
import MainLayout from "../layouts/MainLayout.astro";
import { Heart, Target, Users, Book, FlameIcon, Sprout, Compass, HeartHandshake } from "lucide-react";
---

<MainLayout
  title="Nosotros"
  description="Conoce más sobre nuestra iglesia, visión, misión y equipo pastoral"
>
  
  <section class="relative py-20 bg-white text-church-deep-blue">
  <div class="container mx-auto px-4 text-center">

    <header>
      <h1 class="text-5xl md:text-6xl font-bold mb-6">
        Nuestra Historia
      </h1>
    </header>
    
    <article class="group mx-auto max-w-3xl" id="accordion">
      <div
        class="cursor-pointer text-sm list-none font-medium"
      >
        

        <p class="mx-auto max-w-3xl text-sm md:text-base text-gray-600 leading-relaxed mb-4">
        En 2018, tras dos semanas de oraciones y la realización de dos ayunos,
        los miembros de la zona de Tahuantinsuyo tomaron la decisión de formar
        una nueva obra en esta localidad.<span class="inline group-open:hidden text-blue-600" id="Vmas">..Leer más.</span>
        </p>
        <span class="hidden group-open:block text-blue-600" id="Vmenos">Leer menos</span>
      </div>

      <!-- TEXTO RESTANTE -->
      <div  id="accordion-content" class="overflow-hidden transition-[height] duration-500 ease-in-out text-sm md:text-base text-gray-600 leading-relaxed space-y-4">
        <div class="pt-4 text-gray-600 leading-relaxed space-y-4">
        <p>
          El día martes 23 de setiembre, se tomó formalmente la decisión de
          formar una nueva obra en Tahuantinsuyo. Es entonces donde comienza
          la obra de la iglesia Unidos en Su Presencia, con un cuadro de
          líderes con los que se estaba trabajando en ese momento.
        </p>

        <p>
          Se formó una junta directiva con los líderes mayores y se delegaron
          cargos de responsabilidad en las diferentes áreas del servicio de
          la iglesia, fortaleciendo así la organización y crecimiento de la obra.
        </p>  
        </div>
        
      </div>
      
    </div>

  </article>
</section>

  <!-- Vision & Mission -->
  <section class="py-20 bg-church-deep-blue">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-6xl mx-auto ">
        <div class="card">
          <div class="flex items-center mb-6">
            <div
              class="w-16 h-16 bg-church-deep-blue rounded-full flex items-center justify-center mr-4"
            >
              <Target className="w-8 h-8 text-white" />
            </div>
            <h2 class="text-3xl font-bold text-church-deep-blue">
              Nuestra Visión
            </h2>
          </div>
          <p class="text-gray-700 leading-relaxed text-base">
            Anhelamos una iglesia llena del Espíritu Santo, con identidad Cristiana Bíblica, líderes con formación bíblica,
            teológica, pastoral y de servicio integral a través de Ministerios Especializados 
            y la plantación de nuevos grupos familiares de oración y discipulado. 
          </p>
        </div>

        <div class="card">
          <div class="flex items-center mb-6">
            <div
              class="w-16 h-16 bg-church-gold rounded-full flex items-center justify-center mr-4"
            >
              <Heart className="w-8 h-8 text-gray-900" />
            </div>
            <h2 class="text-3xl font-bold text-church-deep-blue">
              Nuestra Misión
            </h2>
          </div>
          <p class="text-gray-700 leading-relaxed text-base">
            Somos una iglesia unida por el amor de Dios, que adora y alaba al Señor, comprometida con las doctrinas fundamentales
            del cristianismo, la evangelización y el crecimiento del Reino de Dios, la  formación de sus miembros y líderes
            para el servicio integral a la comunidad. 

          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section
    class="py-20 bg-gradient-to-br from-church-blue/5 to-church-deep-blue/5"
  >
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="section-title">Nuestros Valores Fundamentales</h2>
        <p class="section-subtitle">
          Los principios que guían todo lo que hacemos
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto"
      >
        <div
          class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow"
        >
          <div
            class="w-16 h-16 bg-church-accent-orange rounded-full flex items-center justify-center mb-4"
          >
            <FlameIcon className="w-8 h-8 text-church-white"/>
          </div>
          <h3 class="text-xl font-bold text-church-deep-blue mb-3">
            La Oración y El Ayuno
          </h3>
          <p class="text-gray-600">
            Son los elementos importantes que sirven de fundamento a todo lo que hace 
            la Iglesia como cuerpo de Cristo.
          </p>
        </div>

        <div
          class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow"
        >
          <div
            class="w-16 h-16 bg-church-accent-orange rounded-full flex items-center justify-center mb-4"
          >
            <Sprout className="w-8 h-8 text-church-white" />
          </div>
          <h3 class="text-xl font-bold text-church-deep-blue mb-3">
            La Plantación de nuevos Grupos familiares
          </h3>
          <p class="text-gray-600">
            Dever de Iglesia mandado de Jesucristo. ir y hacer discípulos a todas las naciones, bautizándolos en el nombre del Padre, y del Hijo, y del Espíritu Santo.
          </p>
        </div>

        <div
          class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow"
        >
          <div
            class="w-16 h-16 bg-church-accent-orange rounded-full flex items-center justify-center mb-4"
          >
            <Compass className="w-8 h-8 text-church-white" />
          </div>
          <h3 class="text-xl font-bold text-church-deep-blue mb-3">
            Formación del liderazgo
          </h3>
          <p class="text-gray-600">
            En los lugares donde se establezca nuevas células de formación del discipulado, es esencial que haya desarrollo de liderazgo para avanzar aún más en los campos que Dios ha preparado.
          </p>
        </div>

        <div
          class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow"
        >
          <div
            class="w-16 h-16 bg-church-accent-orange rounded-full flex items-center justify-center mb-4"
          >
            <HeartHandshake className="w-8 h-8 text-church-white" />
          </div>
          <h3 class="text-xl font-bold text-church-deep-blue mb-3">
            Misión social
          </h3>
          <p class="text-gray-600">
            Comprende la parte práctica imperativa de identificación cristiana en la comunidad, comenzando por los miembros de la iglesia, atendiendo sus diversas necesidades materiales o espirituales.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pastoral Team -->
  <section class="py-20 bg-church-deep-blue">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="section-title text-church-white">Nuestro Equipo Pastoral</h2>
        <p class="section-subtitle text-church-white">
          Líderes comprometidos con servir a nuestra congregación
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8 max-w-5xl mx-auto"
      >
        <div class="card text-center group">
          <div
            class="w-32 h-32 bg-gradient-to-br from-church-deep-blue to-church-blue rounded-full mx-auto mb-4 flex items-center justify-center text-white text-4xl font-bold group-hover:scale-110 transition-transform"
          > 
            MB
          </div>
          <h3 class="text-xl font-bold text-church-deep-blue mb-1">
            Pastor Michael Baca
          </h3>
          <p class="text-church-gold font-medium mb-3">Pastor Principal</p>
          <p class="text-gray-600 text-sm">
            Sirviendo con pasión y dedicación para guiar a la congregación en el
            camino de Cristo.
          </p>
        </div>

        <div class="card text-center group">
          <div
            class="w-32 h-32 bg-gradient-to-br from-church-blue to-church-gold rounded-full mx-auto mb-4 flex items-center justify-center text-white text-4xl font-bold group-hover:scale-110 transition-transform"
          >
            LA
          </div>
          <h3 class="text-xl font-bold text-church-deep-blue mb-1">
            Pastora Liliana Angeles
          </h3>
          <p class="text-church-gold font-medium mb-3">Pastora Asociada</p>
          <p class="text-gray-600 text-sm">
            Dedicada al ministerio de mujeres y familias, fortaleciendo los
            lazos de nuestra comunidad.
          </p>
        </div>

        
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-church-white text-church-deep-blue">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-4xl font-bold mb-6">¿Quieres Ser Parte?</h2>
      <p class="text-xl text-church-blue mb-8 max-w-2xl mx-auto">
        Te invitamos a conocernos y ser parte de esta familia en Cristo
      </p>
      <a
        href="/contact"
        class="btn-primary bg-church-gold text-gray-900 hover:bg-church-gold/90"
      >
        Contáctanos Hoy
      </a>
    </div>
  </section>
</MainLayout>

<script >
  document.addEventListener("DOMContentLoaded", () => {
    initAccordion();
  });

  function initAccordion(): void {
    const details = document.getElementById("accordion") as HTMLDetailsElement | null;
    const content = document.getElementById("accordion-content") as HTMLDivElement | null;
    const leerMasElement = document.getElementById("Vmas") as HTMLSpanElement | null;
    const leerMenosMinimizar = document.getElementById("Vmenos") as HTMLSpanElement | null;
    

    if (!details || !content) return;
    // Estado inicial
    content.style.height = details.open ? content.scrollHeight + "px" : "0px";
  

    details.addEventListener("click", () => {
    const open = (details.className.includes("group-open"));

      if (!open) {
        // ABRIR
        content.style.height = content.scrollHeight + "px";

        // Limpia el height después de la animación
        setTimeout(() => {
          content.style.height = "auto";
        }, 300);
        leerMasElement?.classList.add("hidden");
        leerMenosMinimizar?.classList.remove("hidden");
        details.classList.add("group-open");
        return ;
      }
        // CERRAR
        content.style.height = content.scrollHeight + "px";
        
        requestAnimationFrame(() => {
          content.style.height = "0px";
        });
        
        leerMasElement?.classList.remove("hidden");
        leerMenosMinimizar?.classList.add("hidden");
        details.classList.remove("group-open");
    });
  }
</script>